{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "redirects": [
    {
      "source": "/",
      "destination": "https://kreatly.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://kreatly.app/:path*",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/push-daily",
      "schedule": "0 7 * * *"
    }
  ]
}
